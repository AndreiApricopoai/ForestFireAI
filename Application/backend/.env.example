# Copy this file to .env and fill in your actual values
# .env is gitignored — never commit it

# MongoDB Atlas connection string
# Replace <password> and update the cluster URL with yours
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/forestfire?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-string

# Port the backend listens on
PORT=3000
