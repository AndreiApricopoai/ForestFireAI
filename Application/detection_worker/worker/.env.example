# Copy this file to .env and fill in your actual values
# .env is gitignored — never commit it

# Full path to your YOLO model weights file
MODEL_PATH=C:\Users\Andrei\Desktop\Models\best.pt

# Path to the folder containing the camera video files
# Both NestJS and the Python worker read videos from here
CAMERAS_FOLDER=C:\Users\Andrei\Desktop\ForestFireAI\Application\cameras

# Path to the folder where annotated snapshots will be saved
# NestJS will serve this folder as static files
SNAPSHOTS_FOLDER=C:\Users\Andrei\Desktop\ForestFireAI\Application\snapshots

# URL of the NestJS backend
BACKEND_URL=http://localhost:3000

# Seconds between each YOLO analysis per camera (default: 5)
ANALYSIS_INTERVAL_SECONDS=5

# Minimum detection confidence to include a result (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.45

# IOU threshold for non-maximum suppression (removes duplicate boxes)
IOU_THRESHOLD=0.45

# Port this Python service will listen on
# NestJS will call http://localhost:8000 to start/stop workers
SERVICE_PORT=8000
